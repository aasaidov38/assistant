# ============================================================
#  Настройки личного ассистента
#  Скопируйте в .env (это делает scripts/setup.sh) и заполните.
#  После изменения:  docker compose up -d
# ============================================================

# --- Общее ---------------------------------------------------
TZ=Asia/Irkutsk
CURRENCY=RUB
FAMILY_NAME=Семья
DEFAULT_KCAL_GOAL=2000
# Для рецептов: на сколько человек готовить
FAMILY_DESC=2 взрослых и 2 детей

# Недельный разбор: день (0 = понедельник ... 6 = воскресенье, -1 = выключить) и час
WEEKLY_DIGEST_DAY=6
WEEKLY_DIGEST_HOUR=20

# Пароли. setup.sh заполнит их сам, менять не нужно.
POSTGRES_PASSWORD=
CORE_API_KEY=

# --- Telegram ------------------------------------------------
# Токен нового бота от @BotFather (не погодного!)
TELEGRAM_BOT_TOKEN=

# Кто может пользоваться ботом: Telegram ID и имя через двоеточие, через запятую.
# Свой ID можно узнать у бота: напишите ему что-нибудь, он ответит «Ваш ID: ...»
ALLOWED_USERS=111111111:Александр,222222222:Яна

# --- ИИ: распознавание текста, чеков и еды ---------------------
# Вариант 1: Claude напрямую
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=

# Вариант 2: OpenRouter (Claude, Gemini и др. по одному ключу)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-...   (точное имя смотрите на openrouter.ai/models)

# Вариант 3: Google Gemini (есть бесплатный лимит)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash             (модели меняются: проверьте командой bash scripts/test-ai.sh)

# Отдельная модель для фото (не обязательно; пусто = та же)
LLM_VISION_MODEL=

# Запасная модель: бот переключится на неё, если основная перегружена (ошибка 503)
# Для Gemini например: gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=

# --- Голосовые сообщения -------------------------------------
# Groq: бесплатный ключ на console.groq.com
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# --- TickTick (не обязательно, можно позже) -------------------
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=

# Публичный адрес ассистента через Caddy (не обязательно)
# PUBLIC_URL=https://assistant.saidov.ru
PUBLIC_URL=

# --- n8n (не обязательно) -------------------------------------
# Адрес Webhook-узла в n8n: туда уходят события (новая трата, задача...)
N8N_WEBHOOK_URL=

# --- Утренняя сводка ------------------------------------------
MORNING_TIME=07:30
WEATHER_LAT=52.29
WEATHER_LON=104.28
WEATHER_PLACE=Иркутск

# --- Веб-панель (вход через бота: команда /web) -----------------
WEB_SESSION_DAYS=30

# --- Яндекс Алиса (docs/INSTALL.md, раздел 17) --------------------------
# Создать: echo "ALICE_SECRET=$(openssl rand -hex 16)" >> .env
ALICE_SECRET=

# --- Мониторинг (scripts/monitor.sh, docs/INSTALL.md, раздел 19) ----------
# MONITOR_CHAT_ID=          кому писать; пусто = первый из ALLOWED_USERS
# MONITOR_URLS=https://n8n.saidov.ru/healthz
# MONITOR_BACKUP_HOURS=26
# MONITOR_DISK_PERCENT=85

# --- Напоминания о платежах, документах, счётчиках и гараже (версия 1.5) ---
# owner — только владельцу (первый в ALLOWED_USERS); author — тому, кто завёл запись; all — всем; или имя: Яна
REMINDERS_TO=owner
# С какого часа (местное время) слать дневные напоминания
DAILY_REMINDER_HOUR=10
